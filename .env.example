# Copy to .env for local PHP. Optional external server stacks may supply DB_* values.
APP_NAME="Wily Starter"
APP_ENV=local
APP_URL=http://localhost:8090

# MySQL settings for a locally running database (adjust to your setup).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wily_starter
DB_USERNAME=wily
DB_PASSWORD=CHANGE_ME

# Optional read-only Admin inbox at GET /admin/dashboard (PSR-15 Basic Auth).
# GET /admin redirects to /admin/dashboard without a Basic Auth challenge.
# Keep both empty to disable the example (404). Never commit real credentials.
# Use only over HTTPS outside of localhost. Local HTTP requires a loopback-bound server.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Optional public HTML page cache for the Guides page (GET /guides).
# 0 = disabled; 60 = one minute (maximum 3600 seconds).
PAGE_CACHE_TTL=60
